            <StreamGeometry x:Key="IconWindowConsole">F1 M5.64645 9.14645C5.84171 8.95118 6.15829 8.95118 6.35355 9.14645L8.35355 11.1464C8.44732 11.2402 8.5 11.3674 8.5 11.5C8.5 11.6326 8.44732 11.7598 8.35355 11.8536L6.35355 13.8536C6.15829 14.0488 5.84171 14.0488 5.64645 13.8536C5.45118 13.6583 5.45118 13.3417 5.64645 13.1464L7.29289 11.5L5.64645 9.85355C5.45118 9.65829 5.45118 9.34171 5.64645 9.14645ZM14.5 13H9.5C9.22386 13 9 13.2239 9 13.5C9 13.7761 9.22386 14 9.5 14H14.5C14.7761 14 15 13.7761 15 13.5C15 13.2239 14.7761 13 14.5 13ZM2.99609 5.5C2.99609 4.11929 4.11538 3 5.49609 3H14.4961C15.8768 3 16.9961 4.11929 16.9961 5.5V6H16.999V7H16.9961V14.5C16.9961 15.8807 15.8768 17 14.4961 17H5.49609C4.11538 17 2.99609 15.8807 2.99609 14.5V5.5ZM15.9961 6V5.5C15.9961 4.67157 15.3245 4 14.4961 4H5.49609C4.66767 4 3.99609 4.67157 3.99609 5.5V6H15.9961ZM3.99609 7V14.5C3.99609 15.3284 4.66767 16 5.49609 16H14.4961C15.3245 16 15.9961 15.3284 15.9961 14.5V7H3.99609Z</StreamGeometry>
            <StreamGeometry x:Key="IconWrench">F1 M8.99952 6.5C8.99952 4.01472 11.0142 2 13.4995 2C14.1589 2 14.7864 2.14214 15.352 2.39792C15.5016 2.46556 15.6084 2.60232 15.6379 2.76381C15.6673 2.92531 15.6156 3.09097 15.4996 3.20705L13.2066 5.49998L14.4996 6.79287L16.7925 4.49998C16.9086 4.3839 17.0742 4.33219 17.2357 4.36164C17.3972 4.39108 17.534 4.49793 17.6016 4.6475C17.8574 5.2131 17.9995 5.84062 17.9995 6.5C17.9995 8.98528 15.9848 11 13.4995 11C13.1189 11 12.7488 10.9526 12.395 10.8633L6.03016 17.3113C5.18266 18.1698 3.82373 18.25 2.88117 17.497C1.79605 16.6302 1.69173 15.0178 2.65608 14.0184L9.08153 7.35911C9.02767 7.08069 8.99952 6.79343 8.99952 6.5ZM13.4995 3C11.5665 3 9.99952 4.567 9.99952 6.5C9.99952 6.80674 10.0389 7.10354 10.1125 7.38597C10.1565 7.55458 10.1095 7.73392 9.98849 7.85931L3.37571 14.7127C2.82045 15.2882 2.88051 16.2166 3.50531 16.7157C4.04803 17.1493 4.8305 17.1031 5.31848 16.6088L11.8923 9.94909C12.0256 9.81397 12.2241 9.76605 12.4044 9.8254C12.7483 9.93857 13.1162 10 13.4995 10C15.4325 10 16.9995 8.433 16.9995 6.5C16.9995 6.25328 16.9741 6.01282 16.9257 5.78097L14.8531 7.85352C14.6579 8.04878 14.3413 8.04879 14.146 7.85353L12.146 5.85355C12.0522 5.75979 11.9995 5.63261 11.9995 5.5C11.9995 5.36739 12.0522 5.24021 12.1459 5.14644L14.2186 3.07383C13.9867 3.02545 13.7462 3 13.4995 3Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Text roles (WinUI type ramp). Bold, not SemiBold: Hangul fonts (Malgun Gothic, Nanum, Noto CJK) have no
             SemiBold, and the fallback then draws Hangul headings in regular weight next to semibold Latin. -->
        <Style Selector=":is(TextBlock).strong">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector=":is(TextBlock).subtitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector=":is(TextBlock).caption">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector=":is(TextBlock).muted">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector=":is(TextBlock).label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        </Style>
        <Style Selector=":is(TextBlock).ok">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </Style>
        <Style Selector=":is(TextBlock).failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </Style>

        <Style Selector="TableViewColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- Surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.badge PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.badge.ok">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.badge.ok PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </Style>

        <!-- Result of the last action: green or red -->
        <Style Selector="Border.infobar">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.infobar.error">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.infobar PathIcon.state">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
            <Setter Property="Data" Value="{StaticResource IconCheckmarkCircle}"/>
        </Style>
        <Style Selector="Border.infobar.error PathIcon.state">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Setter Property="Data" Value="{StaticResource IconErrorCircle}"/>
        </Style>

        <!-- APDU status word: 9000/61xx green, anything else red -->
        <Style Selector="Border.sw">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.sw TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </Style>
        <Style Selector="Border.sw.ok">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.sw.ok TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.segment">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button.tile:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Windows 11 navigation look: subtle fill plus an accent pill instead of the accent selection -->
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="ListBox.nav Border.pill">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Margin" Value="-12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected Border.pill">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Application.Styles>
</Application>
