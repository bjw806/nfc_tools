<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NfcTagger.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Windows 11 (WinUI) theme colours, which the Fluent theme does not define: the same look on both OSes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000"/>
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575"/>
                    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9"/>
                    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#005FB8"/>
                    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#80F6F6F6"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000"/>
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF"/>
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575"/>
                    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#393D1B"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726"/>
                    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#60CDFF"/>
                    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#08FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Denser memory table rows than the theme's 6,9,6,12: a full dump is up to 256 rows. -->
            <Thickness x:Key="TableViewRowPadding">6,5,6,5</Thickness>

            <!-- Real names only: a generic "monospace" at the end of the list is ignored. -->
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Ubuntu Sans Mono, Ubuntu Mono, DejaVu Sans Mono</FontFamily>

            <!-- Fluent UI System Icons (MIT), 20 px regular. Segoe Fluent Icons may not be shipped for Linux. -->
            <StreamGeometry x:Key="IconArrowClockwise">F1 M4 10C4 6.68629 6.68629 4 10 4C11.7766 4 13.3732 4.77191 14.4723 6H12.5C12.2239 6 12 6.22386 12 6.5C12 6.77614 12.2239 7 12.5 7H15.5C15.7761 7 16 6.77614 16 6.5V3.5C16 3.22386 15.7761 3 15.5 3C15.2239 3 15 3.22386 15 3.5V5.10109C13.7299 3.80499 11.9591 3 10 3C6.13401 3 3 6.13401 3 10C3 13.866 6.13401 17 10 17C13.866 17 17 13.866 17 10C17 9.8191 16.9931 9.6397 16.9796 9.46207C16.9587 9.18673 16.7185 8.98049 16.4431 9.00144C16.1678 9.02239 15.9615 9.26258 15.9825 9.53793C15.9941 9.69034 16 9.84443 16 10C16 13.3137 13.3137 16 10 16C6.68629 16 4 13.3137 4 10Z</StreamGeometry>
