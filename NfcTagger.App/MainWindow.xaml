<Window x:Class="NfcTagger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NFC Tagger" Width="1200" Height="760" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubtleIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Windows 11 navigation look: subtle fill plus accent pill instead of the ListBox's solid selection -->
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Style.Triggers>
                <!-- Typography styles pin their own foreground, so dim the whole tile instead. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Navigation -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,16,20">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9A1;" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="NFC Tagger" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="NavList" Margin="8,0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="card" AutomationProperties.Name="카드 정보">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;"/>
                            <TextBlock Text="카드 정보" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ndef" AutomationProperties.Name="NDEF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;"/>
                            <TextBlock Text="NDEF" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="memory" AutomationProperties.Name="메모리">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;"/>
                            <TextBlock Text="메모리" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="apdu" AutomationProperties.Name="APDU">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;"/>
                            <TextBlock Text="APDU" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="log" AutomationProperties.Name="진단 로그">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                            <TextBlock Text="진단 로그" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" Margin="4,16,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Device bar: reader on the left, current card on the right -->
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="DisconnectedPanel" Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Grid Width="328" Margin="12,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="ReaderCombo" DisplayMemberPath="DisplayName" AutomationProperties.Name="리더"
                                          ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"
                                          SelectionChanged="Reader_SelectionChanged"/>
                                <TextBlock x:Name="ReaderPlaceholder" Text="감지된 리더 없음" IsHitTestVisible="False" Margin="12,0,36,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0"
                                    ToolTip="리더 다시 찾기 (F5)" AutomationProperties.Name="리더 다시 찾기" Click="Refresh_Click"/>
                            <Button x:Name="ConnectButton" Content="연결" MinWidth="72" VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}" Click="Connect_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="ConnectedPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </Border>
                            <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderNameText" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="연결됨 · 카드를 자동으로 감지합니다" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                            <Button x:Name="DisconnectButton" Content="연결 해제" VerticalAlignment="Center" Click="Connect_Click"/>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="16,0,0,0" Padding="16,0,0,0" BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <DockPanel>
                                <Button x:Name="CopyUidButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        ToolTip="UID 복사" AutomationProperties.Name="UID 복사" Click="CopyUid_Click"/>
                                <Border x:Name="CardBadge" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="CardBadgeIcon" Style="{StaticResource Icon}" Text="&#xE8C7;"/>
                                </Border>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="BarCardTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="BarCardUid" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="BarCardHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Result of the last action -->
                <Border x:Name="InfoBar" Grid.Row="1" Margin="0,12,0,0" Padding="16,4,6,4" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE711;" FontSize="12"
                                VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="닫기" AutomationProperties.Name="알림 닫기" Click="CloseInfo_Click"/>
                        <TextBlock x:Name="InfoIcon" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBlock x:Name="InfoText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,8,8"/>
                    </DockPanel>
                </Border>

                <!-- Why this page cannot be used right now -->
                <Border x:Name="PageNotice" Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                   VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <TextBlock x:Name="PageNoticeText" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <!-- Card -->
                    <Grid x:Name="CardPage">
                        <StackPanel x:Name="CardEmpty" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="CardEmptyIcon" Style="{StaticResource Icon}" FontSize="34"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <TextBlock x:Name="CardEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,20,0,8"/>
                            <TextBlock x:Name="CardEmptyBody" Style="{StaticResource Muted}" TextAlignment="Center"/>
                            <Button x:Name="ScanButton" Content="지금 스캔 (F5)" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,20,0,0" Click="Scan_Click"/>
                        </StackPanel>
                        <ScrollViewer x:Name="CardPresent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="340" Height="214" CornerRadius="14" Padding="22" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3D6DF2" Offset="0"/>
                                                <GradientStop Color="#1E3C9C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Top" Margin="0,0,40,0">
                                                <TextBlock Text="현재 카드" Foreground="#C8FFFFFF" FontSize="12"/>
                                                <TextBlock x:Name="CardFamilyText" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9A1;" FontSize="26" Foreground="White"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="UID" Foreground="#C8FFFFFF" FontSize="12"/>
                                                <TextBlock x:Name="CardUidText" Foreground="White" FontSize="20" FontFamily="{StaticResource MonoFont}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                        <TextBlock Text="카드 상세" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="원시 타입" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="CardRawText" Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Grid.Row="1" Text="상세" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="CardDetailsText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Grid.Row="2" Text="리더" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="CardReaderText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                                        </Grid>
                                        <TextBlock Text="UID 복사" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4"/>
                                        <Grid>
                                            <!-- Values share one Auto column so the copy buttons line up right after the longest value -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto" MinWidth="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="HEX" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="리더가 읽은 바이트 순서 그대로 (빅엔디언)"/>
                                            <TextBlock x:Name="UidHexText" Grid.Column="1" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" Tag="HEX"
                                                    CommandParameter="{Binding Text, ElementName=UidHexText}" ToolTip="HEX 복사" AutomationProperties.Name="HEX 복사" Click="CopyUidFormat_Click"/>
                                            <TextBlock Grid.Row="1" Text="HEX 역순" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="바이트 순서를 뒤집은 값 (리틀엔디언)"/>
                                            <TextBlock x:Name="UidHexReversedText" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" Tag="HEX 역순"
                                                    CommandParameter="{Binding Text, ElementName=UidHexReversedText}" ToolTip="HEX 역순 복사" AutomationProperties.Name="HEX 역순 복사" Click="CopyUidFormat_Click"/>
                                            <TextBlock Grid.Row="2" Text="10진" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="HEX를 10진수로 바꾼 값"/>
                                            <TextBlock x:Name="UidDecText" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" Tag="10진"
                                                    CommandParameter="{Binding Text, ElementName=UidDecText}" ToolTip="10진 복사" AutomationProperties.Name="10진 복사" Click="CopyUidFormat_Click"/>
                                            <TextBlock Grid.Row="3" Text="10진 역순" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="HEX 역순을 10진수로 바꾼 값"/>
                                            <TextBlock x:Name="UidDecReversedText" Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" Tag="10진 역순"
                                                    CommandParameter="{Binding Text, ElementName=UidDecReversedText}" ToolTip="10진 역순 복사" AutomationProperties.Name="10진 역순 복사" Click="CopyUidFormat_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="이 카드로 할 수 있는 작업" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,12"/>
                                <UniformGrid Columns="3">
                                    <Button x:Name="NdefTile" Tag="ndef" Style="{StaticResource Tile}" Margin="0,0,12,0"
                                            AutomationProperties.Name="NDEF" Click="Tile_Click">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="22" HorizontalAlignment="Left"/>
                                            <TextBlock Text="NDEF" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,2"/>
                                            <TextBlock x:Name="NdefTileText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MemoryTile" Tag="memory" Style="{StaticResource Tile}" Margin="0,0,12,0"
                                            AutomationProperties.Name="메모리" Click="Tile_Click">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="22" HorizontalAlignment="Left"/>
                                            <TextBlock Text="메모리" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,2"/>
                                            <TextBlock x:Name="MemoryTileText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ApduTile" Tag="apdu" Style="{StaticResource Tile}"
                                            AutomationProperties.Name="APDU" Click="Tile_Click">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="22" HorizontalAlignment="Left"/>
                                            <TextBlock Text="APDU" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,2"/>
                                            <TextBlock x:Name="ApduTileText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- NDEF -->
                    <ScrollViewer x:Name="NdefPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="NdefReadButton" DockPanel.Dock="Right" Content="태그 읽기" MinWidth="80"
                                                Style="{StaticResource AccentButtonStyle}" Click="NdefRead_Click"/>
                                        <TextBlock Text="읽기" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="NdefResultEmpty" Text="태그 읽기를 누르면 여기에 표시됩니다." Style="{StaticResource Muted}" Margin="0,24,0,0"/>
                                    <StackPanel x:Name="NdefResultPanel" Visibility="Collapsed" Margin="0,20,0,0">
                                        <Border Padding="16,12,8,12" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleIconButton}" Content="&#xE8C8;" VerticalAlignment="Top"
                                                        ToolTip="내용 복사" AutomationProperties.Name="NDEF 내용 복사" Click="CopyNdef_Click"/>
                                                <TextBlock x:Name="NdefResult" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="NdefMeta" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                        <Expander Header="원시 HEX" Margin="0,8,0,0">
                                            <TextBox x:Name="NdefRawHex" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                                     Margin="0,8,0,0" AutomationProperties.Name="원시 HEX"/>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="쓰기" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
                                        <RadioButton x:Name="NdefTextMode" Content="텍스트" GroupName="NdefKind" IsChecked="True"
                                                     Style="{StaticResource Segment}" Checked="NdefKind_Checked"/>
                                        <RadioButton x:Name="NdefUrlMode" Content="URL" GroupName="NdefKind"
                                                     Style="{StaticResource Segment}" Checked="NdefKind_Checked"/>
                                    </StackPanel>
                                    <TextBox x:Name="NdefInput" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="쓸 내용" TextChanged="NdefInput_TextChanged"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="NdefSize" DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="NdefHint" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    </DockPanel>
                                    <Button x:Name="NdefWriteButton" Content="카드에 쓰기" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="NdefWrite_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Memory -->
                    <Grid x:Name="MemoryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16,14,16,16">
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="시작 주소" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MemoryAddress" Text="4" Width="96" AutomationProperties.Name="시작 주소"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="개수 (최대 64)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MemoryCount" Text="16" Width="96" AutomationProperties.Name="개수"/>
                                </StackPanel>
                                <StackPanel x:Name="KeyRow" Orientation="Horizontal" Visibility="Collapsed">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="MIFARE 키 (카드가 바뀌면 지워짐)" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="KeyBox" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="MIFARE 키"
                                                     ToolTip="6바이트 HEX (예: FFFFFFFFFFFF)"/>
                                    </StackPanel>
                                    <CheckBox x:Name="KeyB" Content="Key B" VerticalAlignment="Bottom" Margin="0,0,16,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                    <Button x:Name="MemoryReadButton" Content="범위 읽기" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="MemoryRead_Click"/>
                                    <Button x:Name="DumpButton" Content="전체 읽기" Margin="0,0,8,0" Click="Dump_Click"/>
                                    <Button x:Name="CancelDumpButton" Content="읽기 취소" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelDump_Click"/>
                                    <Button x:Name="ExportDumpButton" Content="JSON 내보내기"
                                            ToolTip="마지막 전체 읽기 또는 쓰기 전 백업을 JSON 파일로 저장합니다" Click="ExportDump_Click"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                                    <TextBlock x:Name="MemorySource" DockPanel.Dock="Right" Style="{StaticResource FieldLabel}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="읽기 결과" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <DataGrid x:Name="MemoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                                              CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                                              Background="Transparent" Margin="8,0,8,8" SelectionChanged="MemoryGrid_SelectionChanged">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="주소" Binding="{Binding AddressText}" Width="104" MinWidth="104" FontFamily="{StaticResource MonoFont}"/>
                                            <!-- Hex/ASCII fit their bytes (16 per MIFARE block) so data is never clipped; status takes the rest -->
                                            <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="Auto" MinWidth="200" FontFamily="{StaticResource MonoFont}"/>
                                            <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="Auto" MinWidth="100" FontFamily="{StaticResource MonoFont}"/>
                                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="*" MinWidth="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="MemoryEmpty" Text="범위 읽기나 전체 읽기를 누르면 결과가 여기에 표시됩니다."
                                               Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="쓰기 주소" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="새 데이터 (HEX) · 표에서 행을 고르면 현재 값이 채워집니다" Style="{StaticResource FieldLabel}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,0,6"/>
                                <TextBox x:Name="WriteAddress" Grid.Row="1" Width="96" AutomationProperties.Name="쓰기 주소"/>
                                <TextBox x:Name="MemoryWriteHex" Grid.Row="1" Grid.Column="1" Margin="12,0" FontFamily="{StaticResource MonoFont}"
                                         AutomationProperties.Name="새 데이터"/>
                                <Button x:Name="MemoryWriteButton" Grid.Row="1" Grid.Column="2" Content="검토 후 쓰기"
                                        ToolTip="보호 영역(제조사·잠금·섹터 트레일러)은 자동으로 막습니다"
                                        Style="{StaticResource AccentButtonStyle}" Click="MemoryWrite_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- APDU -->
                    <Grid x:Name="ApduPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="명령 (HEX)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ApduInput" Grid.Row="1" Text="00A4040000" FontFamily="{StaticResource MonoFont}"
                                         AutomationProperties.Name="APDU 명령" KeyDown="ApduInput_KeyDown"/>
                                <Button x:Name="ApduSendButton" Grid.Row="1" Grid.Column="1" Content="전송" MinWidth="80" Margin="8,0,0,0"
                                        Style="{StaticResource AccentButtonStyle}" Click="ApduSend_Click"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                           Text="Enter로 전송합니다. 카드·리더별 명령 형식을 아는 경우에만 사용하세요."/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                                    <Button DockPanel.Dock="Right" Content="기록 지우기" Click="ClearApdu_Click"/>
                                    <TextBlock Text="기록" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <ListBox x:Name="ApduHistory" Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ApduHistory_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource FieldLabel}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap">
                                                            <Run Text="→ " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding Command, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <Run Text="← " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding Data, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border x:Name="SwBadge" Grid.Column="2" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Top"
                                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                                                        <TextBlock x:Name="SwText" Text="{Binding Sw}" FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter TargetName="SwBadge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                                        <Setter TargetName="SwText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ApduEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" Margin="16"
                                               Text="보낸 명령과 응답이 여기에 쌓입니다. 항목을 누르면 명령을 다시 입력합니다."/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Log -->
                    <Border x:Name="LogPage" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="복사" Margin="0,0,8,0" Click="CopyLog_Click"/>
                                    <Button Content="지우기" Click="ClearLog_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="진단 로그" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="명령 내용과 MIFARE 키는 남기지 않습니다. 앱을 닫으면 지워집니다."
                                               Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12"
                                     AutomationProperties.Name="진단 로그"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,6">
                <DockPanel>
                    <StackPanel x:Name="BusyPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar x:Name="BusyBar" Width="160" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="FooterStatus" Text="준비됨" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- In-window confirmation for writes -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Rectangle Fill="{DynamicResource SmokeFillColorDefaultBrush}"/>
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Margin="24,22,24,20">
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="DialogBody" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <Border Margin="0,16,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DialogDetail" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <Border Padding="24,18" CornerRadius="0,0,7,7" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DialogConfirm" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="DialogConfirm_Click"/>
                            <Button x:Name="DialogCancel" Grid.Column="2" Content="취소" HorizontalAlignment="Stretch" Click="DialogCancel_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
