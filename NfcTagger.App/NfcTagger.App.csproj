<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NfcTagger.Core\NfcTagger.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NfcTagger</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationIcon>Assets\NfcTagger.ico</ApplicationIcon>
    <!-- no libicu dependency on Linux -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <!-- SkiaSharp and HarfBuzzSharp publish ~100 MB of native debug symbols that aren't needed to run -->
  <Target Name="DropNativeSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)libHarfBuzzSharp.pdb" />
  </Target>

</Project>
